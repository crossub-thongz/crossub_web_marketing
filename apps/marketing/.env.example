# Browser calls same-origin /api; Next.js proxies to crossub_web API.
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:3001

# Cross-app links (optional in dev)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_HR_URL=http://localhost:3003
NEXT_PUBLIC_SALES_URL=http://localhost:3004

# Public site URL used for sharing metadata.
# NEXT_PUBLIC_SITE_URL=https://www.crossub.com.au
# Agent product, not the marketing site.
# NEXT_PUBLIC_LOGIN_URL=https://agent.crossub.com.au/
# NEXT_PUBLIC_REGISTER_URL=https://crossub-mobile-agent-prod.onrender.com/register
